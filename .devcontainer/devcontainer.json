{
  "name": "Bazaar",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "postCreateCommand": "python -m pip install -e '.[dev]' && make generate",
  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt",
        "anthropic.claude-code"
      ]
    }
  },
  "forwardPorts": [3001]
}
